# ==============================================================================
# Denim LACS - Backend Environment Variables
# কনফিগারেশন সেটিংস (Pydantic-Settings দ্বারা নিয়ন্ত্রিত)
# ==============================================================================

ENVIRONMENT=development
PROJECT_NAME="Denim Laser Automation & Control System (Denim LACS)"
API_V1_STR=/api/v1

# ডেটাবেজ কনফিগারেশন (PostgreSQL 16)
POSTGRES_SERVER=lacs-dev-db
POSTGRES_PORT=5432
POSTGRES_DB=lacs_dev
POSTGRES_USER=lacs_user
POSTGRES_PASSWORD=lacs_secure_pass_2026

# সিকিউরিটি ও ক্রিপ্টোগ্রাফি
SECRET_KEY=lacs_dev_secret_key_change_in_production_2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=30

# সিওআরএস অরিজিনস (লোকাল ল্যান সাবনেট)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:8000", "http://127.0.0.1:5173", "http://192.168.1.100"]

# সেন্ট্রাল লেজার ডিজাইন ভল্ট পাথ
VAULT_STORAGE_PATH=/data/vault

