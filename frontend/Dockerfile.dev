# ==============================================================================
# Denim LACS - Frontend Development Container Dockerfile (Node 22 Alpine)
# শতভাগ ডকার কনটেইনারাইজড ডেভেলপমেন্ট পরিবেশ (রুল ২১ মেনে তৈরি)
# ==============================================================================

FROM node:22-alpine

WORKDIR /app

# প্যাকেজ ডেফিনিশন কপি ও ডিপেন্ডেন্সি ইনস্টলেশন
COPY package.json ./
RUN npm install

# সোর্স কোড কপি
COPY . ./

# Vite ডেভেলপমেন্ট সার্ভার পোর্ট
EXPOSE 5173

# হোস্টের সাথে বাইন্ড করে লাইভ হট-রিলোড মোডে Vite চালানো
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
